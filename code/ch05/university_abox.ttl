# ============================================================================
# university_abox.ttl
# ----------------------------------------------------------------------------
# ABox of the University knowledge base -- instance data only.
#
# This file imports the TBox so that a reasoner loading it gets the full KB.
# In production this file is typically generated by an ETL job and is NOT
# hand-edited, whereas university_tbox.ttl is reviewed and version-controlled.
#
# Note: no rdf:type is declared for courses -- the reasoner infers it from
# the rdfs:range of uni:enrolledIn / uni:teaches.
# ============================================================================

@prefix uni:  <http://example.org/university#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix wd:   <http://www.wikidata.org/entity/> .

<http://example.org/university/data> a owl:Ontology ;
    rdfs:label   "University Ontology — ABox"@en ;
    owl:imports  <http://example.org/university> ;
    owl:versionInfo "2025-06-01 snapshot" .

# ============================================================================
# Organizations
# ============================================================================

uni:exampleUniversity a owl:NamedIndividual , uni:University ;
    rdfs:label "Example University"@en ;
    foaf:homepage <https://www.example.edu/> .

uni:engineeringFaculty a owl:NamedIndividual , uni:Faculty ;
    rdfs:label "Faculty of Engineering"@en ;
    uni:partOf uni:exampleUniversity .

uni:scienceFaculty a owl:NamedIndividual , uni:Faculty ;
    rdfs:label "Faculty of Science"@en ;
    uni:partOf uni:exampleUniversity .

uni:csDept a owl:NamedIndividual , uni:Department ;
    rdfs:label "Department of Computer Science"@en ;
    uni:partOf uni:engineeringFaculty .

uni:mathDept a owl:NamedIndividual , uni:Department ;
    rdfs:label "Department of Mathematics"@en ;
    uni:partOf uni:scienceFaculty .

# ============================================================================
# Degrees
# ============================================================================

uni:phdCS a owl:NamedIndividual , uni:Doctorate ;
    rdfs:label "PhD in Computer Science"@en .

uni:phdMath a owl:NamedIndividual , uni:Doctorate ;
    rdfs:label "PhD in Mathematics"@en .

# ============================================================================
# Courses -- deliberately NOT typed; the reasoner infers uni:Course
# ============================================================================

uni:cs101 a owl:NamedIndividual , uni:UndergraduateCourse ;
    rdfs:label     "Introduction to Programming"@en ;
    uni:courseCode "CS101" ;
    uni:credits    3 .

uni:cs201 a owl:NamedIndividual , uni:UndergraduateCourse ;
    rdfs:label     "Data Structures"@en ;
    uni:courseCode "CS201" ;
    uni:credits    3 .

uni:cs301 a owl:NamedIndividual , uni:UndergraduateCourse ;
    rdfs:label     "Database Systems"@en ;
    uni:courseCode "CS301" ;
    uni:credits    3 .

uni:cs501 a owl:NamedIndividual , uni:GraduateCourse ;
    rdfs:label     "Knowledge Graphs and Semantic Web"@en ;
    uni:courseCode "CS501" ;
    uni:credits    4 .

uni:cs601 a owl:NamedIndividual , uni:GraduateCourse ;
    rdfs:label     "Advanced Machine Learning"@en ;
    uni:courseCode "CS601" ;
    uni:credits    4 .

uni:ma101 a owl:NamedIndividual , uni:UndergraduateCourse ;
    rdfs:label     "Calculus I"@en ;
    uni:courseCode "MA101" ;
    uni:credits    4 .

# ============================================================================
# Staff
# ============================================================================

uni:profSmith a owl:NamedIndividual , uni:Professor ;
    rdfs:label      "Jane Smith"@en ;
    foaf:name       "Jane Smith" ;
    uni:employeeId  "E-1042" ;
    uni:hasDegree   uni:phdCS ;
    uni:memberOf    uni:csDept ;
    uni:teaches     uni:cs101 , uni:cs501 , uni:cs601 ;
    uni:supervises  uni:alice ;
    uni:authorOf    uni:paper001 , uni:paper002 .

uni:profJones a owl:NamedIndividual , uni:Professor ;
    rdfs:label      "Robert Jones"@en ;
    foaf:name       "Robert Jones" ;
    uni:employeeId  "E-1077" ;
    uni:hasDegree   uni:phdMath ;
    uni:memberOf    uni:mathDept ;
    uni:teaches     uni:ma101 ;
    uni:colleagueOf uni:profSmith .

uni:adminBrown a owl:NamedIndividual , uni:AdminStaff ;
    rdfs:label     "Sarah Brown"@en ;
    uni:employeeId "E-2011" ;
    uni:memberOf   uni:csDept .

# ============================================================================
# Students
# ============================================================================

uni:alice a owl:NamedIndividual , uni:Student ;
    rdfs:label         "Alice Johnson"@en ;
    foaf:name          "Alice Johnson" ;
    uni:studentId      "S-2024-0421" ;
    uni:enrollmentYear 2022 ;
    uni:gpa            3.85 ;
    uni:memberOf       uni:csDept ;
    uni:enrolledIn     uni:cs501 , uni:cs601 ;
    uni:authorOf       uni:paper002 .

uni:bob a owl:NamedIndividual , uni:Student ;
    rdfs:label         "Bob Martinez"@en ;
    foaf:name          "Bob Martinez" ;
    uni:studentId      "S-2024-0512" ;
    uni:enrollmentYear 2024 ;
    uni:gpa            3.20 ;
    uni:memberOf       uni:csDept ;
    uni:enrolledIn     uni:cs101 , uni:cs201 .

uni:carol a owl:NamedIndividual , uni:Student ;
    rdfs:label         "Carol Nguyen"@en ;
    foaf:name          "Carol Nguyen" ;
    uni:studentId      "S-2023-0198" ;
    uni:enrollmentYear 2023 ;
    uni:gpa            3.95 ;
    uni:memberOf       uni:mathDept ;
    uni:enrolledIn     uni:ma101 , uni:cs101 .

uni:dave a owl:NamedIndividual , uni:Student ;
    rdfs:label         "Dave Wilson"@en ;
    uni:studentId      "S-2024-0777" ;
    uni:enrollmentYear 2024 ;
    uni:memberOf       uni:csDept .
    # dave has no enrolledIn at all -- under OWA this means "unknown",
    # NOT "not enrolled in anything".

# ============================================================================
# Publications
# ============================================================================

uni:paper001 a owl:NamedIndividual , uni:Publication ;
    rdfs:label "Scalable Reasoning over Large Knowledge Graphs"@en .

uni:paper002 a owl:NamedIndividual , uni:Publication ;
    rdfs:label "Ontology Design Patterns for Higher Education"@en .

# ============================================================================
# Identity assertions
# ----------------------------------------------------------------------------
# OWL has no Unique Name Assumption. Without owl:AllDifferent the reasoner
# cannot conclude that alice is enrolled in TWO courses -- cs501 and cs601
# might denote the same course as far as it knows.
# ============================================================================

[] a owl:AllDifferent ;
   owl:members ( uni:alice uni:bob uni:carol uni:dave
                 uni:profSmith uni:profJones uni:adminBrown ) .

[] a owl:AllDifferent ;
   owl:members ( uni:cs101 uni:cs201 uni:cs301 uni:cs501 uni:cs601 uni:ma101 ) .

[] a owl:AllDifferent ;
   owl:members ( uni:csDept uni:mathDept uni:engineeringFaculty
                 uni:scienceFaculty uni:exampleUniversity ) .

# Link to external datasets
uni:exampleUniversity owl:sameAs <https://www.example.edu/id/university> .

# Explicit negative assertion: bob is definitely NOT enrolled in cs501.
# This is different from simply having no triple (which would mean "unknown").
[] a owl:NegativePropertyAssertion ;
   owl:sourceIndividual  uni:bob ;
   owl:assertionProperty uni:enrolledIn ;
   owl:targetIndividual  uni:cs501 .
