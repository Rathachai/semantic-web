# ============================================================================
# university.ttl
# ----------------------------------------------------------------------------
# Combined University knowledge base (TBox + RBox + ABox) used in Chapter 05
# and Chapter 07. Generated by merging:
#   code/ch05/university_tbox.ttl
#   code/ch05/university_abox.ttl
# ============================================================================

@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix uni: <http://example.org/university#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

uni:BusyProfessor a owl:Class ;
    rdfs:label "Busy Professor"@en ;
    rdfs:comment "A professor teaching three or more courses in the current term."@en ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( uni:Professor [ a owl:Restriction ;
                        owl:minQualifiedCardinality "3"^^xsd:nonNegativeInteger ;
                        owl:onClass uni:Course ;
                        owl:onProperty uni:teaches ] ) ] .

uni:PublishedResearcher a owl:Class ;
    rdfs:label "Published Researcher"@en ;
    rdfs:comment "Anyone who has authored at least one publication."@en ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty uni:authorOf ;
            owl:someValuesFrom uni:Publication ] .

uni:Supervisor a owl:Class ;
    rdfs:label "Supervisor"@en ;
    rdfs:comment "A professor who supervises at least one graduate student."@en ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( uni:Professor [ a owl:Restriction ;
                        owl:onProperty uni:supervises ;
                        owl:someValuesFrom uni:GraduateStudent ] ) ] .

uni:UndergraduateStudent a owl:Class ;
    rdfs:label "Undergraduate Student"@en ;
    rdfs:comment "A student enrolled only in undergraduate courses."@en ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( uni:Student [ a owl:Restriction ;
                        owl:allValuesFrom uni:UndergraduateCourse ;
                        owl:onProperty uni:enrolledIn ] [ a owl:Restriction ;
                        owl:onProperty uni:enrolledIn ;
                        owl:someValuesFrom uni:UndergraduateCourse ] ) ] .

uni:colleagueOf a owl:IrreflexiveProperty,
        owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "colleague of"@en ;
    rdfs:domain uni:Staff ;
    rdfs:range uni:Staff .

uni:courseCode a owl:DatatypeProperty,
        owl:FunctionalProperty,
        owl:InverseFunctionalProperty ;
    rdfs:label "course code"@en ;
    rdfs:domain uni:Course ;
    rdfs:range xsd:string .

uni:credits a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "credits"@en ;
    rdfs:domain uni:Course ;
    rdfs:range xsd:integer .

uni:employeeId a owl:DatatypeProperty,
        owl:FunctionalProperty,
        owl:InverseFunctionalProperty ;
    rdfs:label "employee ID"@en ;
    rdfs:domain uni:Staff ;
    rdfs:range xsd:string .

uni:enrollmentYear a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "enrollment year"@en ;
    rdfs:domain uni:Student ;
    rdfs:range xsd:integer .

uni:gpa a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "grade point average"@en ;
    rdfs:domain uni:Student ;
    rdfs:range xsd:decimal .

uni:hasSupervisor a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "has supervisor"@en ;
    owl:inverseOf uni:supervises .

uni:instructorOf a owl:ObjectProperty ;
    rdfs:label "instructor of"@en ;
    rdfs:comment "A professor is an instructor of every student enrolled in a course they teach."@en ;
    owl:propertyChainAxiom ( uni:teaches uni:hasStudent ) .

uni:memberOfOrganization a owl:ObjectProperty ;
    rdfs:label "member of organization"@en ;
    owl:propertyChainAxiom ( uni:memberOf uni:partOf ) .

uni:studentId a owl:DatatypeProperty,
        owl:FunctionalProperty,
        owl:InverseFunctionalProperty ;
    rdfs:label "student ID"@en ;
    rdfs:comment "Official student identifier; uniquely identifies one student."@en ;
    rdfs:domain uni:Student ;
    rdfs:range xsd:string .

uni:taughtBy a owl:ObjectProperty ;
    rdfs:label "taught by"@en ;
    owl:inverseOf uni:teaches .

<http://example.org/university/data> a owl:Ontology ;
    rdfs:label "University Ontology — ABox"@en ;
    owl:imports <http://example.org/university> ;
    owl:versionInfo "2025-06-01 snapshot" .

<http://example.org/university> a owl:Ontology ;
    dcterms:created "2025-01-15"^^xsd:date ;
    dcterms:description "Schema for students, staff, courses and organizational units."@en ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2025-06-01"^^xsd:date ;
    dcterms:title "University Ontology — TBox"@en ;
    vann:preferredNamespacePrefix "uni" ;
    vann:preferredNamespaceUri "http://example.org/university#" ;
    owl:versionIRI <http://example.org/university/1.2.0> ;
    owl:versionInfo "1.2.0" .

uni:AdminStaff a owl:Class ;
    rdfs:label "Administrative Staff"@en ;
    rdfs:comment "A staff member in a non-academic role."@en ;
    rdfs:subClassOf uni:Staff .

uni:GraduateStudent a owl:Class ;
    rdfs:label "Graduate Student"@en ;
    rdfs:comment "A student enrolled in at least one graduate course."@en ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( uni:Student [ a owl:Restriction ;
                        owl:onProperty uni:enrolledIn ;
                        owl:someValuesFrom uni:GraduateCourse ] ) ] .

uni:University a owl:Class ;
    rdfs:label "University"@en ;
    rdfs:subClassOf uni:Organization .

uni:adminBrown a uni:AdminStaff,
        owl:NamedIndividual ;
    rdfs:label "Sarah Brown"@en ;
    uni:employeeId "E-2011" ;
    uni:memberOf uni:csDept .

uni:authorOf a owl:ObjectProperty ;
    rdfs:label "author of"@en ;
    rdfs:range uni:Publication .

uni:carol a uni:Student,
        owl:NamedIndividual ;
    rdfs:label "Carol Nguyen"@en ;
    uni:enrolledIn uni:cs101,
        uni:ma101 ;
    uni:enrollmentYear 2023 ;
    uni:gpa 3.95 ;
    uni:memberOf uni:mathDept ;
    uni:studentId "S-2023-0198" ;
    foaf:name "Carol Nguyen" .

uni:cs301 a uni:UndergraduateCourse,
        owl:NamedIndividual ;
    rdfs:label "Database Systems"@en ;
    uni:courseCode "CS301" ;
    uni:credits 3 .

uni:dave a uni:Student,
        owl:NamedIndividual ;
    rdfs:label "Dave Wilson"@en ;
    uni:enrollmentYear 2024 ;
    uni:memberOf uni:csDept ;
    uni:studentId "S-2024-0777" .

uni:hasDegree a owl:ObjectProperty ;
    rdfs:label "has degree"@en ;
    rdfs:domain uni:Person ;
    rdfs:range uni:Degree .

uni:hasStudent a owl:ObjectProperty ;
    rdfs:label "has student"@en ;
    owl:inverseOf uni:enrolledIn .

uni:memberOf a owl:ObjectProperty ;
    rdfs:label "member of"@en ;
    rdfs:domain uni:Person ;
    rdfs:range uni:Organization .

uni:paper001 a uni:Publication,
        owl:NamedIndividual ;
    rdfs:label "Scalable Reasoning over Large Knowledge Graphs"@en .

uni:partOf a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "part of"@en ;
    rdfs:comment "Organizational containment: Department partOf Faculty partOf University."@en ;
    rdfs:domain uni:Organization ;
    rdfs:range uni:Organization .

uni:phdCS a uni:Doctorate,
        owl:NamedIndividual ;
    rdfs:label "PhD in Computer Science"@en .

uni:phdMath a uni:Doctorate,
        owl:NamedIndividual ;
    rdfs:label "PhD in Mathematics"@en .

uni:profJones a uni:Professor,
        owl:NamedIndividual ;
    rdfs:label "Robert Jones"@en ;
    uni:colleagueOf uni:profSmith ;
    uni:employeeId "E-1077" ;
    uni:hasDegree uni:phdMath ;
    uni:memberOf uni:mathDept ;
    uni:teaches uni:ma101 ;
    foaf:name "Robert Jones" .

uni:Agent a owl:Class ;
    rdfs:label "Agent"@en ;
    rdfs:comment "Anything capable of acting: a person or an organization."@en .

uni:Department a owl:Class ;
    rdfs:label "Department"@en ;
    rdfs:subClassOf uni:Organization .

uni:Faculty a owl:Class ;
    rdfs:label "Faculty"@en ;
    rdfs:comment "An academic division grouping several departments."@en ;
    rdfs:subClassOf uni:Organization .

uni:alice a uni:Student,
        owl:NamedIndividual ;
    rdfs:label "Alice Johnson"@en ;
    uni:authorOf uni:paper002 ;
    uni:enrolledIn uni:cs501,
        uni:cs601 ;
    uni:enrollmentYear 2022 ;
    uni:gpa 3.85 ;
    uni:memberOf uni:csDept ;
    uni:studentId "S-2024-0421" ;
    foaf:name "Alice Johnson" .

uni:bob a uni:Student,
        owl:NamedIndividual ;
    rdfs:label "Bob Martinez"@en ;
    uni:enrolledIn uni:cs101,
        uni:cs201 ;
    uni:enrollmentYear 2024 ;
    uni:gpa 3.20 ;
    uni:memberOf uni:csDept ;
    uni:studentId "S-2024-0512" ;
    foaf:name "Bob Martinez" .

uni:cs201 a uni:UndergraduateCourse,
        owl:NamedIndividual ;
    rdfs:label "Data Structures"@en ;
    uni:courseCode "CS201" ;
    uni:credits 3 .

uni:engineeringFaculty a uni:Faculty,
        owl:NamedIndividual ;
    rdfs:label "Faculty of Engineering"@en ;
    uni:partOf uni:exampleUniversity .

uni:involvedIn a owl:ObjectProperty ;
    rdfs:label "involved in"@en ;
    rdfs:comment "Generic relation between a person and a course."@en ;
    rdfs:domain uni:Person ;
    rdfs:range uni:Course .

uni:paper002 a uni:Publication,
        owl:NamedIndividual ;
    rdfs:label "Ontology Design Patterns for Higher Education"@en .

uni:profSmith a uni:Professor,
        owl:NamedIndividual ;
    rdfs:label "Jane Smith"@en ;
    uni:authorOf uni:paper001,
        uni:paper002 ;
    uni:employeeId "E-1042" ;
    uni:hasDegree uni:phdCS ;
    uni:memberOf uni:csDept ;
    uni:supervises uni:alice ;
    uni:teaches uni:cs101,
        uni:cs501,
        uni:cs601 ;
    foaf:name "Jane Smith" .

uni:scienceFaculty a uni:Faculty,
        owl:NamedIndividual ;
    rdfs:label "Faculty of Science"@en ;
    uni:partOf uni:exampleUniversity .

uni:supervises a owl:ObjectProperty ;
    rdfs:label "supervises"@en ;
    rdfs:domain uni:Professor ;
    rdfs:range uni:Student .

uni:Degree a owl:Class ;
    rdfs:label "Degree"@en .

uni:Doctorate a owl:Class ;
    rdfs:label "Doctorate"@en ;
    rdfs:subClassOf uni:Degree .

uni:cs601 a uni:GraduateCourse,
        owl:NamedIndividual ;
    rdfs:label "Advanced Machine Learning"@en ;
    uni:courseCode "CS601" ;
    uni:credits 4 .

uni:exampleUniversity a uni:University,
        owl:NamedIndividual ;
    rdfs:label "Example University"@en ;
    owl:sameAs <https://www.example.edu/id/university> ;
    foaf:homepage <https://www.example.edu/> .

uni:ma101 a uni:UndergraduateCourse,
        owl:NamedIndividual ;
    rdfs:label "Calculus I"@en ;
    uni:courseCode "MA101" ;
    uni:credits 4 .

uni:mathDept a uni:Department,
        owl:NamedIndividual ;
    rdfs:label "Department of Mathematics"@en ;
    uni:partOf uni:scienceFaculty .

uni:teaches a owl:ObjectProperty ;
    rdfs:label "teaches"@en ;
    rdfs:domain uni:Professor ;
    rdfs:range uni:Course ;
    rdfs:subPropertyOf uni:involvedIn ;
    owl:propertyDisjointWith uni:enrolledIn .

uni:GraduateCourse a owl:Class ;
    rdfs:label "Graduate Course"@en ;
    rdfs:subClassOf uni:Course .

uni:cs101 a uni:UndergraduateCourse,
        owl:NamedIndividual ;
    rdfs:label "Introduction to Programming"@en ;
    uni:courseCode "CS101" ;
    uni:credits 3 .

uni:cs501 a uni:GraduateCourse,
        owl:NamedIndividual ;
    rdfs:label "Knowledge Graphs and Semantic Web"@en ;
    uni:courseCode "CS501" ;
    uni:credits 4 .

uni:Publication a owl:Class ;
    rdfs:label "Publication"@en .

uni:Person a owl:Class ;
    rdfs:label "Person"@en ;
    rdfs:comment "A human being affiliated with the university."@en ;
    rdfs:subClassOf uni:Agent ;
    owl:equivalentClass foaf:Person .

uni:Professor a owl:Class ;
    rdfs:label "Professor"@en ;
    rdfs:comment "A staff member who teaches and conducts research."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty uni:hasDegree ;
            owl:someValuesFrom uni:Doctorate ],
        uni:Staff .

uni:Staff a owl:Class ;
    rdfs:label "Staff"@en ;
    rdfs:comment "A person employed by the university."@en ;
    rdfs:subClassOf uni:Person .

uni:UndergraduateCourse a owl:Class ;
    rdfs:label "Undergraduate Course"@en ;
    rdfs:subClassOf uni:Course ;
    owl:disjointWith uni:GraduateCourse .

uni:csDept a uni:Department,
        owl:NamedIndividual ;
    rdfs:label "Department of Computer Science"@en ;
    uni:partOf uni:engineeringFaculty .

uni:enrolledIn a owl:ObjectProperty ;
    rdfs:label "enrolled in"@en ;
    rdfs:comment """Relates a student to a course they currently attend.
Does not cover completed or dropped courses."""@en ;
    rdfs:domain uni:Student ;
    rdfs:range uni:Course ;
    rdfs:subPropertyOf uni:involvedIn .

uni:Organization a owl:Class ;
    rdfs:label "Organization"@en ;
    rdfs:subClassOf uni:Agent .

uni:Course a owl:Class ;
    rdfs:label "Course"@en ;
    rdfs:comment "A unit of teaching delivered over one academic term."@en .

uni:Student a owl:Class ;
    rdfs:label "Student"@en ;
    rdfs:comment """A person admitted to a degree programme. Covers currently
enrolled students only; use uni:Alumnus for graduates."""@en ;
    rdfs:subClassOf uni:Person ;
    owl:disjointWith uni:Staff .

[] a owl:AllDifferent ;
    owl:members ( uni:alice uni:bob uni:carol uni:dave uni:profSmith uni:profJones uni:adminBrown ) .

[] a owl:AllDifferent ;
    owl:members ( uni:csDept uni:mathDept uni:engineeringFaculty uni:scienceFaculty uni:exampleUniversity ) .

[] a owl:NegativePropertyAssertion ;
    owl:assertionProperty uni:enrolledIn ;
    owl:sourceIndividual uni:bob ;
    owl:targetIndividual uni:cs501 .

[] a owl:AllDifferent ;
    owl:members ( uni:cs101 uni:cs201 uni:cs301 uni:cs501 uni:cs601 uni:ma101 ) .

[] a owl:AllDisjointClasses ;
    owl:members ( uni:Person uni:Organization uni:Course uni:Degree uni:Publication ) .

