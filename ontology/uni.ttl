@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<http://example.org/uni> a owl:Ontology ;
    owl:versionIRI <http://example.org/uni/1.0.0> ;
    dcterms:title  "University Ontology (full)"@en ;
    owl:imports
        <http://example.org/uni/core> ,
        <http://example.org/uni/academic> ,
        <http://example.org/uni/hr> ,
        <http://example.org/uni/library> .
